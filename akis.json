    },
    {
      "text": "Görünmek isteyen güzel",
      "id": 202608091100,
      "category": "posts/seyirdefteri/202608091100"
    },
    {
      "text": "Aynayı tut yüzü~ne",
      "id": 202608091027,
      "category": "posts/seyirdefteri/202608091027"
    },
    {
      "text": "Ruhullah olandan işitti, kulağı açık olanlar:\n\nKainatı tanıyan kişi, tanımamışsa kendini, kainatı da tanıyamaz!\n\nHer şey...",
      "id": 202608072234,
      "category": "sabahnesesi"
    },
    {
      "text": "Seni bir nefesçik bile terk etmemiş olan şeye doğru yolculuğa çıkamazsın ey sevgili,\n\nYokluktan başlayan her arayış, ara...",
      "id": 202608072230,
      "category": "sabahnesesi"
    },
    {
      "text": "Daha da yaklaşın...",
      "id": 202608072230,
      "category": "posts/seyirdefteri/202608072230"
    },
    {
      "text": "Aşk olduğu belli olsun",
      "id": 202608072227,
      "category": "posts/seyirdefteri/202608072227"
    },
    {
      "text": "Ben Yoğum İmzası",
      "id": 202608072210,
      "category": "posts/seyirdefteri/202608072210"
    },
    {
      "text": "Gönül Kâbe~sin tavaf ederler",
      "id": 202608072206,
      "category": "posts/seyirdefteri/202608072206"
